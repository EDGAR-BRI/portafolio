---
import { translations, type Lang } from '../data/site';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  stack: string[];
  repo: string;
  demo?: string;
  featured?: boolean;
  year?: string;
  lang: Lang;
}

const { title, subtitle, description, stack, repo, demo, featured, year, lang } = Astro.props;
const t = translations[lang];
---

<article class={`project-card ${featured ? 'featured' : ''}`}>
  {featured && <span class="badge">{t.featured}</span>}
  <header>
    <h3 class="title">{title}</h3>
    <p class="subtitle">{subtitle}</p>
  </header>

  <p class="description">{description}</p>

  <ul class="stack" aria-label="Tech stack">
    {stack.map((item) => <li class="chip">{item}</li>)}
  </ul>

  <footer class="actions">
    <a href={repo} target="_blank" rel="noopener noreferrer" class="btn">
      <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
        <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/>
      </svg>
      {t.repo_link}
    </a>
    {demo && (
      <a href={demo} target="_blank" rel="noopener noreferrer" class="btn ghost">
        {t.demo_link} ↗
      </a>
    )}
    {year && <span class="year">{year}</span>}
  </footer>
</article>

<style>
.project-card {
  position: relative;
  background: rgba(22, 27, 34, 0.6);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  backdrop-filter: blur(6px);
}

.project-card:hover {
  transform: translateY(-3px);
  border-color: var(--accent);
  box-shadow: 0 6px 24px rgba(74, 222, 128, 0.12);
}

.project-card.featured {
  border-color: rgba(74, 222, 128, 0.3);
}

.badge {
  position: absolute;
  top: -10px;
  right: 1rem;
  background: var(--accent);
  color: var(--bg);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  letter-spacing: 0.05em;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
}

.title {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--fg);
  font-family: 'JetBrains Mono', ui-monospace, monospace;
}

.subtitle {
  margin: 0.25rem 0 0 0;
  font-size: 0.85rem;
  color: var(--accent);
  opacity: 0.85;
}

.description {
  margin: 0;
  font-size: 0.9rem;
  color: var(--muted);
  line-height: 1.55;
  flex: 1;
}

.stack {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.chip {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 0.7rem;
  padding: 0.25rem 0.6rem;
  background: rgba(74, 222, 128, 0.1);
  color: var(--accent);
  border: 1px solid rgba(74, 222, 128, 0.25);
  border-radius: 6px;
  letter-spacing: 0.02em;
}

.actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.5rem;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 0.9rem;
  background: var(--accent);
  color: var(--bg);
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.85rem;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(74, 222, 128, 0.3);
}

.btn.ghost {
  background: transparent;
  color: var(--fg);
  border: 1px solid var(--border);
}

.btn.ghost:hover {
  border-color: var(--accent);
  box-shadow: none;
}

.year {
  margin-left: auto;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 0.8rem;
  color: var(--muted);
}
</style>