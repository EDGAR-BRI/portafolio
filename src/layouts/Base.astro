---
import '../styles/global.css';
import LangToggle from '../components/LangToggle.vue';
import BootScreen from '../components/BootScreen.vue';
import ScrollProgress from '../components/ScrollProgress.vue';
import TerminalNav from '../components/TerminalNav.vue';
import { social } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');

const { title = 'Edgar Briceño · Full-stack Developer y Portafolio', description = 'Portafolio de Edgar Briceño, desarrollador full-stack especializado en Astro, Vue, AdonisJS y Node.js. Descubre mis proyectos, stack técnico y cómo contactarme.' } = Astro.props;

const ogImage = new URL('/og.png', Astro.site).toString();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Edgar Briceño',
  alternateName: 'Edgar Bri',
  url: siteUrl,
  email: 'mailto:' + social.email,
  jobTitle: 'Full-stack Developer',
  description: 'Desarrollador full-stack especializado en Astro, Vue, AdonisJS y Node.js. Apasionado por el código limpio y las comunidades open source.',
  image: ogImage,
  knowsAbout: ['Astro', 'Vue 3', 'React', 'TypeScript', 'Node.js', 'AdonisJS', 'Tailwind CSS', 'PostgreSQL', 'Docker'],
  sameAs: [social.github],
  mainEntityOfPage: canonical,
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Edgar Briceño · Portfolio',
  alternateName: 'Portafolio de Edgar Briceño',
  url: siteUrl,
  inLanguage: 'es',
  description,
  author: { '@type': 'Person', name: 'Edgar Briceño', url: siteUrl },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Edgar Briceño" />
    <meta name="theme-color" content="#06080b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Edgar Briceño · Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <script is:inline>
      (function () {
        try {
          if (window.sessionStorage.getItem('portfolio.booted') !== '1') {
            document.documentElement.classList.add('boot-pending');
          }
        } catch (e) {
          document.documentElement.classList.add('boot-pending');
        }
      })();
    </script>
  </head>
  <body>
    <BootScreen client:load />
    <ScrollProgress client:load />

    <header class="site-header">
      <TerminalNav client:load />
      <LangToggle client:load />
    </header>

    <div class="bg-grid" aria-hidden="true"></div>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('portfolio.lang');
          var nav = (navigator.language || 'es').slice(0, 2).toLowerCase();
          var lang = saved || (nav === 'en' ? 'en' : 'es');
          document.documentElement.lang = lang;
        } catch (e) {
          document.documentElement.lang = 'es';
        }

        // Header compact on scroll
        try {
          var header = document.querySelector('.site-header');
          if (header) {
            var handleHeaderScroll = function () {
              if (window.scrollY > 20) {
                header.classList.add('is-scrolled');
              } else {
                header.classList.remove('is-scrolled');
              }
            };
            window.addEventListener('scroll', handleHeaderScroll, { passive: true });
            handleHeaderScroll();
          }
        } catch (e) {}
      })();
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.9rem 2rem;
        background: rgba(6, 8, 11, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
        opacity: 1;
        transition: padding 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                    background 0.25s ease,
                    border-color 0.25s ease,
                    box-shadow 0.25s ease,
                    opacity 0.4s ease 0.55s;
      }

      .site-header.is-scrolled {
        padding: 0.5rem 2rem;
        background: rgba(6, 8, 11, 0.94);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom-color: rgba(74, 222, 128, 0.2);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), 0 1px 0 rgba(74, 222, 128, 0.1);
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 4rem;
        transform: translateY(0);
        opacity: 1;
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.45s ease;
      }

      html.boot-pending,
      html.boot-pending body {
        overflow: hidden !important;
        height: 100vh !important;
        touch-action: none !important;
      }

      html.boot-pending .site-header,
      html.boot-pending .scroll-progress {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        transition: none !important;
      }

      html.boot-pending main {
        transform: translateY(-100vh);
        opacity: 0;
        transition: none;
      }

      html.boot-dropping main {
        transform: translateY(0) !important;
        opacity: 1 !important;
      }

      @media (max-width: 768px) {
        .site-header {
          display: grid;
          grid-template-columns: 1fr auto;
          grid-template-rows: auto auto;
          align-items: center;
          gap: 0.45rem 0.5rem;
          padding: 0.55rem 1rem;
        }

        .site-header.is-scrolled {
          padding: 0.35rem 0.85rem;
          gap: 0.25rem 0.5rem;
        }

        main {
          padding: 0 1rem 3rem;
        }
      }

      @media (max-width: 380px) {
        .site-header {
          padding: 0.45rem 0.75rem;
          gap: 0.35rem 0.4rem;
        }

        .site-header.is-scrolled {
          padding: 0.3rem 0.65rem;
          gap: 0.2rem 0.4rem;
        }

        main {
          padding: 0 0.75rem 2.5rem;
        }
      }
    </style>
  </body>
</html>