---
import '../styles/global.css';
import LangToggle from '../components/LangToggle.vue';
import BootScreen from '../components/BootScreen.vue';
import ScrollProgress from '../components/ScrollProgress.vue';
import TerminalNav from '../components/TerminalNav.vue';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Edgar Briceño · Portfolio', description = 'Full-stack developer building with Astro, Vue, AdonisJS and modern web tooling.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          if (window.sessionStorage.getItem('portfolio.booted') !== '1') {
            document.documentElement.classList.add('boot-pending');
          }
        } catch (e) {
          document.documentElement.classList.add('boot-pending');
        }
      })();
    </script>
  </head>
  <body>
    <BootScreen client:load />
    <ScrollProgress client:load />

    <header class="site-header">
      <TerminalNav client:load />
      <LangToggle client:load />
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('portfolio.lang');
          var nav = (navigator.language || 'es').slice(0, 2).toLowerCase();
          var lang = saved || (nav === 'en' ? 'en' : 'es');
          document.documentElement.lang = lang;
        } catch (e) {
          document.documentElement.lang = 'es';
        }
      })();
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        background: rgba(6, 8, 11, 0.85);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
        opacity: 1;
        transition: opacity 0.4s ease 0.55s;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 4rem;
        transform: translateY(0);
        opacity: 1;
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.45s ease;
      }

      html.boot-pending .site-header {
        opacity: 0;
        transition: none;
      }

      html.boot-pending main {
        transform: translateY(-100vh);
        opacity: 0;
        transition: none;
      }

      html.boot-dropping main {
        transform: translateY(0) !important;
        opacity: 1 !important;
      }

      @media (max-width: 640px) {
        .site-header { padding: 0.75rem 1rem; flex-wrap: wrap; gap: 0.5rem; }
        .brand { font-size: 0.85rem; }
      }
    </style>
  </body>
</html>